# From Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# The public address of the site, used in profile links (no trailing slash)
VITE_SITE_URL=https://puls.so
# Set to "true" after enabling Google in Supabase → Authentication → Providers
VITE_ENABLE_GOOGLE=false
